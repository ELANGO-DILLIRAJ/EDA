Experiment 8: Time Series Analysis and Visualization Program: 
import pandas as pd import matplotlib.pyplot as plt data = pd.read_csv("daily_sales_2025_v2.csv") 
data["Date"] = pd.to_datetime(data["Date"]) data = data.sort_values("Date") data.set_index("Date", inplace=True) 
# Daily Sales Trend plt.figure(figsize=(12, 5)) plt.plot(data.index, data["Sales"], linewidth=1) 
plt.title("Daily Sales Trend - 2025") plt.xlabel("Date") plt.ylabel("Sales (₹)") plt.grid(True) plt.show() 
# Calculate 7-Day Moving Average data["Moving_Average"] = data["Sales"].rolling(window=7).mean() 
# Plot Sales and Moving Average plt.figure(figsize=(12, 5)) plt.plot(data.index, data["Sales"], alpha=0.5, label="Daily Sales") 
plt.plot(data.index, data["Moving_Average"], linewidth=2, label="7-Day Moving Average") 
plt.title("Daily Sales and 7-Day Moving Average") plt.xlabel("Date") plt.ylabel("Sales (₹)") plt.legend() plt.grid(True) plt.show() 
# Monthly Sales monthly_sales = data["Sales"].resample("ME").sum() print("\nMonthly Sales:") print(monthly_sales) 
# Monthly Sales Visualization plt.figure(figsize=(10, 5)) plt.plot(monthly_sales.index, monthly_sales.values, marker="o") 
plt.title("Monthly Sales Trend") plt.xlabel("Month") plt.ylabel("Total Sales (₹)") plt.grid(True) plt.show()

Experiment 9: Geographical Data Visualization Program: 
import pandas as pd import folium data = pd.read_csv("india_cities.csv") print("First Five Records:") print(data.head()) 
india_map = folium.Map(location=[22.5, 78.9], zoom_start=5) for _, row in data.iterrows():    
popup_text = (        f"City: {row['City']}<br>"        f"State: {row['State']}<br>"        f"Population: {row['Population']:,}"    )    
folium.Marker(        location=[row["Latitude"], row["Longitude"]],        popup=popup_text,        tooltip=row["City"]    ).add_to(india_map) india_map 
# Circle Marker Version population_map = folium.Map(location=[22.5, 78.9], zoom_start=5) 
for _, row in data.iterrows():
folium.CircleMarker(location=[row["Latitude"], row["Longitude"]],radius=max(4, row["Population"]/1000000),popup=row["City"],tooltip=row["City"],fill=True).add_to(population_map) population_map

