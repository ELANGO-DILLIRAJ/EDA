Experiment 11: EDA on Wine Quality Dataset Program: 
import pandas as pd import matplotlib.pyplot as plt import seaborn as sns data = pd.read_csv("winequality-red.csv", sep=";") 
print("First Five Records:") print(data.head()) print("\nDataset Shape:") print(data.shape) print("\nData Types:") print(data.dtypes) print("\nMissing Values:") print(data.isnull().sum()) 
print("\nDescriptive Statistics:") print(data.describe()) 
# Distribution of Wine Quality plt.figure(figsize=(8, 5)) sns.countplot(data=data, x="quality") 
plt.title("Distribution of Wine Quality") plt.xlabel("Quality Score") plt.ylabel("Number of Wines") plt.show() 
# Alcohol Distribution plt.figure(figsize=(8, 5)) plt.hist(data["alcohol"], bins=15, edgecolor="black") 
plt.title("Distribution of Alcohol Content") plt.xlabel("Alcohol (%)") plt.ylabel("Frequency") plt.show() 
# Box Plot of Alcohol by Quality plt.figure(figsize=(8, 5)) sns.boxplot(data=data, x="quality", y="alcohol") 
plt.title("Alcohol Content by Wine Quality") plt.xlabel("Quality") plt.ylabel("Alcohol (%)") plt.show() 
# Volatile Acidity by Quality plt.figure(figsize=(8, 5)) sns.boxplot(data=data, x="quality", y="volatile acidity") 
plt.title("Volatile Acidity by Wine Quality") plt.xlabel("Quality") plt.ylabel("Volatile Acidity") plt.show()

